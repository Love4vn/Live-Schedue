name: Scrape LiveOnSat Schedule

on:
  schedule:
    - cron: '0 */6 * * *'
  workflow_dispatch:

jobs:
  scrape:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'
      - name: Install dependencies
        run: |
          pip install -r requirements.txt
          playwright install chromium
      - name: Run scraper with debug
        env:
          DEBUG_LIVEONSAT: 1
        run: python src/scrape_liveonsat.py
      - name: Upload debug artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: liveonsat-debug
          path: |
            liveonsat_debug.html
            liveonsat_debug.png
            liveonsat_schedule.json
      - name: Commit and push if changed
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add liveonsat_schedule.json
          git diff --quiet && git diff --staged --quiet || git commit -m "Update liveonsat schedule"
          git push
